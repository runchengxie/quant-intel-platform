{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-intel-platform.example/schemas/market-intel-a-share-charts.v1.json",
  "title": "Public A-share chart payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "publication", "report_id", "date", "kind", "generated_at", "content_sha256", "charts"],
  "properties": {
    "schema_version": {"const": "market_intel.a_share_charts.v1"},
    "publication": {"const": "public"},
    "report_id": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-(morning|evening)$"},
    "date": {"type": "string", "format": "date"},
    "kind": {"enum": ["morning", "evening"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "content_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "charts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/chart"}}
  },
  "$defs": {
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "status", "points"],
      "properties": {
        "key": {"type": "string"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["ok", "degraded", "missing", "skipped"]},
        "reason": {"type": ["string", "null"]},
        "points": {"type": "array", "items": {"$ref": "#/$defs/point"}}
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value", "unit", "observation_date", "source_label", "source_url"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "observation_date": {"type": "string", "format": "date"},
        "source_label": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    }
  }
}
