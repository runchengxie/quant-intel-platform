{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market_intel_pages.weekly_recap.v1",
  "description": "Structural schema. Python validator additionally checks identity/date consistency, Friday cutoff, ordered unique dates, UTF-8 limits, finite numbers and canonical content hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "publication",
    "report_id",
    "date",
    "generated_at",
    "content_hash",
    "markdown",
    "source_url",
    "image",
    "summary",
    "series",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "market_intel_pages.weekly_recap.v1"
    },
    "publication": {
      "const": "public"
    },
    "report_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-weekly$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "markdown": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000000
    },
    "source_url": {
      "type": "string",
      "pattern": "^reports/\\d{4}-\\d{2}-\\d{2}-weekly\\.md$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "sha256",
        "width",
        "height"
      ],
      "properties": {
        "source_url": {
          "type": "string",
          "pattern": "^reports/\\d{4}-\\d{2}-\\d{2}-weekly\\.png$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_regime",
        "value_streak_weeks",
        "value_return_12w_percent",
        "small_crowding",
        "large_crowding",
        "size_signal"
      ],
      "properties": {
        "value_regime": {
          "enum": [
            "MOMENTUM",
            "NEUTRAL"
          ]
        },
        "value_streak_weeks": {
          "type": "integer",
          "minimum": 1
        },
        "value_return_12w_percent": {
          "type": "number"
        },
        "small_crowding": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "large_crowding": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "size_signal": {
          "enum": [
            "small_cap",
            "large_cap",
            "insufficient"
          ]
        }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "size"
      ],
      "properties": {
        "value": {
          "type": "array",
          "minItems": 1,
          "maxItems": 104,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "return_12w_percent",
              "wealth_index"
            ],
            "properties": {
              "date": {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "return_12w_percent": {
                "type": "number"
              },
              "wealth_index": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "size": {
          "type": "array",
          "minItems": 1,
          "maxItems": 252,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "relative_strength",
              "small_crowding",
              "large_crowding"
            ],
            "properties": {
              "date": {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "relative_strength": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "small_crowding": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "large_crowding": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "size"
      ],
      "properties": {
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "as_of",
            "sha256"
          ],
          "properties": {
            "schema_version": {
              "const": "research.weekly_analysis.v1"
            },
            "as_of": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "size": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "as_of",
            "sha256"
          ],
          "properties": {
            "schema_version": {
              "const": "research.weekly_analysis.v1"
            },
            "as_of": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  }
}
