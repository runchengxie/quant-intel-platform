{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-intel-platform.example/schemas/research-platform-publication.v1.json",
  "title": "Research platform publication manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "producer_repository", "producer_commit", "run_id", "artifacts"],
  "properties": {
    "schema_version": {"const": "research.platform-publication.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "producer_repository": {"type": "string", "minLength": 1},
    "producer_commit": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "relative_path", "schema_version", "sha256", "media_type", "audience", "consumers"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\).+"},
        "schema_version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "media_type": {"type": "string", "minLength": 1},
        "audience": {"enum": ["public", "internal"]},
        "consumers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
