---
import '../../styles/site.css';
import '../../styles/editorial.css';
import '../../styles/research-language.css';
import ChartCards from '../../components/ChartCards.astro';
import { loadReports, loadMarkdown, loadChart } from '../../lib/reports.ts';
import { renderMarkdown } from '../../lib/markdown.ts';
import { buildAsiaReportSvg } from '../../lib/asia-report-image.mjs';

export function getStaticPaths() {
  return loadReports().map((report) => ({ params: { id: report.id }, props: { report } }));
}

const { report } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const markdown = loadMarkdown(report);
const body = renderMarkdown(markdown);
const charts = report.kind === 'evening' ? loadChart(report.id) : null;
const visualReport = charts ? buildAsiaReportSvg(report, charts, markdown) : null;
const chartSources = [...new Map((charts || []).flatMap((chart) => (chart.points || [])
  .filter((point) => /^https:\/\//.test(point.source_url))
  .map((point) => [point.source_url, point.source_label]))).entries()];
---
<!doctype html>
<html lang="zh-CN">
    <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#f4f0e8" /><title>{report.title} · Quant 市场情报</title></head>
  <body>
    <header class="topbar"><a class="brand" href={`${base}/`}><span class="brand-mark">Q</span><span>QUANT <b>MARKET INTEL</b></span></a><div class="top-actions"><span class="top-note">{report.kind === 'morning' ? '晨报' : '晚报'} · {report.date}</span><a class="docs-link" href={`${base}/docs/`}>方法与文档</a></div></header>
    <main class="report-shell">
      <nav class="crumb"><a href={`${base}/`}>← 返回日报首页</a></nav>
      <div class="report-heading"><span class="eyebrow">{report.kind === 'morning' ? '历史晨报' : '亚洲市场晚报'}</span><h1>{report.title}</h1><p>{report.summary}</p>{report.generation_mode === 'backfill' && <p class="backfill-note">这份报告是后续补发的，生成时间见报告正文。</p>}<a class="source-link" href={`${base}/${report.source_url}`}>查看 Markdown 原文</a></div>
      {visualReport ? <section class="panel" aria-label="亚洲市场图文复盘">
        <div class="link-row report-actions"><button type="button" id="download-asia-report" data-report-image data-report-date={report.date} data-report-kind="asia-daily" data-chart-target="#asia-daily-chart svg" data-status-target="#asia-chart-download-status">下载图片版 PNG</button></div>
        <p id="asia-chart-download-status" class="section-note" role="status" aria-live="polite"></p>
        <div class="market-chart-graphic market-report-graphic" id="asia-daily-chart" set:html={visualReport} />
        <details class="secondary-report"><summary>阅读完整报告与来源</summary><article class="report-body markdown-body" set:html={body} /><ChartCards reportId={report.id} />{chartSources.length > 0 && <><h3>图表来源</h3><ul>{chartSources.map(([href, label]) => <li><a href={href} target="_blank" rel="noreferrer">{label} · {href}</a></li>)}</ul></>}</details>
      </section> : <><ChartCards reportId={report.id} /><article class="panel report-body markdown-body" set:html={body} /></>}
    </main>
    <footer class="footer"><span>QUANT MARKET INTEL</span><span>市场信息仅供研究参考</span></footer>
    <script>
      document.querySelectorAll('[data-report-image]').forEach((button) => button.addEventListener('click', async () => {
        const chart = document.querySelector(button.dataset.chartTarget);
        const status = document.querySelector(button.dataset.statusTarget);
        if (!chart || !status) return;
        button.disabled = true;
        status.textContent = '正在生成 PNG…';
        try {
          const { downloadMarketChartPng } = await import('../../lib/market-chart-download.ts');
          await downloadMarketChartPng(chart, button.dataset.reportDate, button.dataset.reportKind);
          status.textContent = '图片版 PNG 已生成。';
        } catch {
          status.textContent = 'PNG 生成失败。请直接阅读网页报告。';
        } finally {
          button.disabled = false;
        }
      }));
    </script>
  </body>
</html>
