---
import '../../../styles/site.css';
import '../../../styles/editorial.css';
import '../../../styles/research-language.css';
import ChartCards from '../../../components/ChartCards.astro';
import { loadReports, loadMarkdown, loadChart } from '../../../lib/reports.ts';
import { renderMarkdown } from '../../../lib/markdown.ts';
import { buildAsiaReportSvg } from '../../../lib/asia-report-image';
import { localePath } from '../../../lib/locale.ts';

export function getStaticPaths() {
  return loadReports().map((report) => ({ params: { id: report.id }, props: { report } }));
}

const { report } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const markdown = loadMarkdown(report);
const body = renderMarkdown(markdown);
const charts = report.kind === 'evening' ? loadChart(report.id) : null;
const visualReport = charts ? buildAsiaReportSvg(report, charts, markdown) : null;
const chartSources = [...new Map((charts || []).flatMap((chart) => (chart.points || [])
  .filter((point) => /^https?:\/\//.test(point.source_url))
  .map((point) => [point.source_url, point.source_label]))).entries()];
---
<!doctype html>
<html lang="en-US">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#f4f0e8" /><title>{report.title} · Quant Market Intel</title></head>
  <body>
    <header class="topbar"><a class="brand" href={localePath('en-US', base)}><span class="brand-mark">Q</span><span>QUANT <b>MARKET INTEL</b></span></a><div class="top-actions"><span class="top-note">{report.kind === 'morning' ? 'Morning report' : 'Evening report'} · {report.date}</span><a class="docs-link" href={`${base}/docs/`}>Documentation</a><a class="docs-link" href={`${base}/reports/${report.id}/`}>中文</a></div></header>
    <main class="report-shell">
      <nav class="crumb"><a href={localePath('en-US', base)}>← Back to English reports</a></nav>
      <div class="report-heading"><span class="eyebrow">{report.kind === 'morning' ? 'Morning report' : 'Asia evening report'}</span><h1>{report.title}</h1><p>{report.summary}</p>{report.generation_mode === 'backfill' && <p class="backfill-note">This report was backfilled; the generation time is recorded in the source report.</p>}<p class="section-note">The report body below is the canonical published source-language artifact. This English route localizes the navigation and presentation shell while preserving the evidence text and identifiers.</p><a class="source-link" href={`${base}/${report.source_url}`}>View canonical Markdown</a></div>
      {visualReport ? <section class="panel" aria-label="Asia market visual review">
        <div class="link-row report-actions"><button type="button" id="download-asia-report" data-report-image data-report-date={report.date} data-report-kind="asia-daily" data-chart-target="#asia-daily-chart svg" data-status-target="#asia-chart-download-status">Download PNG</button></div>
        <p id="asia-chart-download-status" class="section-note" role="status" aria-live="polite"></p>
        <div class="market-chart-graphic market-report-graphic" id="asia-daily-chart" set:html={visualReport} />
        <details class="secondary-report"><summary>Read source report and evidence</summary><article class="report-body markdown-body" set:html={body} /><ChartCards reportId={report.id} />{chartSources.length > 0 && <><h3>Chart sources</h3><ul>{chartSources.map(([href, label]) => <li><a href={href} target="_blank" rel="noreferrer">{label} · {href}</a></li>)}</ul></>}</details>
      </section> : <><ChartCards reportId={report.id} /><article class="panel report-body markdown-body" set:html={body} /></>}
    </main>
    <footer class="footer"><span>QUANT MARKET INTEL</span><span>For research reference only</span></footer>
    <script>
      document.querySelectorAll('[data-report-image]').forEach((button) => button.addEventListener('click', async () => {
        const chart = document.querySelector(button.dataset.chartTarget);
        const status = document.querySelector(button.dataset.statusTarget);
        if (!chart || !status) return;
        button.disabled = true;
        status.textContent = 'Generating PNG…';
        try {
          const { downloadMarketChartPng } = await import('../../../lib/market-chart-download.ts');
          await downloadMarketChartPng(chart, button.dataset.reportDate, button.dataset.reportKind);
          status.textContent = 'PNG generated.';
        } catch {
          status.textContent = 'PNG generation failed. Read the web report instead.';
        } finally {
          button.disabled = false;
        }
      }));
    </script>
  </body>
</html>
