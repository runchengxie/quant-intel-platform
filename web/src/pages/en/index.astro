---
import '../../styles/site.css';
import '../../styles/editorial.css';
import { loadReports, loadMarketDaily } from '../../lib/reports.ts';
import { localePath } from '../../lib/locale.ts';

const reports = loadReports();
const market = loadMarketDaily();
const latestEvening = reports.find((report) => report.kind === 'evening');
const latestMorning = reports.find((report) => report.kind === 'morning');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f0e8" />
    <meta name="description" content="Quant Market Intel: public, source-linked daily market reports." />
    <title>Quant Market Intel</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href={localePath('en-US', base)}><span class="brand-mark">Q</span><span>QUANT <b>MARKET INTEL</b></span></a>
      <nav class="top-nav" aria-label="Primary navigation"><a href="#reports">Reports</a><a href={`${base}/docs/`}>Documentation</a><a href={localePath('zh-CN', base)}>中文</a></nav>
    </header>
    <main class="shell">
      <div class="content">
        <section class="hero">
          <div class="hero-copy"><span class="eyebrow">Public daily market intelligence</span><h1>Quant Market Intel</h1><p>Structured U.S. and Asian market reports with source dates, evidence links, and explicit data-quality boundaries.</p></div>
        </section>
        <section class="panel" id="reports" aria-labelledby="reports-title">
          <div class="section-heading"><span class="eyebrow">Latest publications</span><h2 id="reports-title">Reports</h2></div>
          <div class="report-list">
            {market && <article class="report-tile"><div class="report-meta"><time>{market.date}</time><span>U.S. daily report</span></div><h3><a href={`${base}/reports/${market.date}-market-daily.md`}>U.S. market close review</a></h3><p>Structured market facts, interpretation, and source links.</p></article>}
            {latestEvening && <article class="report-tile"><div class="report-meta"><time>{latestEvening.date}</time><span>Asia evening report</span></div><h3><a href={`${base}/en/reports/${latestEvening.id}/`}>{latestEvening.title}</a></h3><p>{latestEvening.summary}</p></article>}
            {latestMorning && <article class="report-tile"><div class="report-meta"><time>{latestMorning.date}</time><span>Morning report</span></div><h3><a href={`${base}/en/reports/${latestMorning.id}/`}>{latestMorning.title}</a></h3><p>{latestMorning.summary}</p></article>}
          </div>
          {!market && !latestEvening && !latestMorning && <p class="empty">No public reports are currently available.</p>}
        </section>
        <section class="panel"><div class="section-heading"><h2>Reading boundary</h2></div><p>Reports are for research and information organization. Machine-readable artifacts remain language-neutral; this page is an English presentation layer over the same public evidence.</p></section>
      </div>
    </main>
    <footer class="footer"><span>QUANT MARKET INTEL</span><span>For research reference only</span></footer>
  </body>
</html>
