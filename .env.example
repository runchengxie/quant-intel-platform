# Copy api_keys.json.example to this Git-ignored path and restrict the real file to the
# current user (chmod 600 on Linux; equivalent user-only ACL on Windows).
API_KEYS_PATH=./api_keys.json
# Optional: Inline configuration for AI Market News (default is GLM-4.6)
# API_KEYS='{"ai_news":{"provider":"glm","model":"glm-4.6","enable_network":true,"keys":["your_glm_key_primary","your_glm_key_backup"]}}'

# Switch the provider for AI Market News (defaults to glm, can be set to gemini)
# AI_NEWS_PROVIDER=glm
# Optional: Globally override the default model
# AI_NEWS_MODEL=glm-4.6

# GLM / Zhipu AI Credentials (used by default)
GLM_MODEL=glm-4.6
GLM_ENABLE_NETWORK=1
GLM_THINKING=enabled
GLM_KEY_1=your_glm_key_1
GLM_KEY_2=your_glm_key_2
GLM_KEY_3=your_glm_key_3

# Aliyun / Bailian fallback or primary configuration (optional)
# AI_NEWS_PROVIDER=aliyun
# ALIYUN_MODEL=qwen3.7-flash
# ALIYUN_ENABLE_NETWORK=1
# ALIYUN_API_KEY=your_dashscope_api_key

# Gemini Credentials (set AI_NEWS_PROVIDER=gemini to use)
GEMINI_MODEL=gemini-2.5-pro
GEMINI_ENABLE_NETWORK=1
GEMINI_KEY_1=your_gemini_key_1
GEMINI_KEY_2=your_gemini_key_2
GEMINI_KEY_3=your_gemini_key_3

# EDGAR user agent
EDGAR_USER_AGENT="DailyMessenger/1.0 (contact: [email protected])"

# Feishu webhooks
FEISHU_WEBHOOK_DAILY=your_feishu_daily_webhook
FEISHU_SECRET_DAILY=your_feishu_daily_secret
FEISHU_WEBHOOK_ALERTS=your_feishu_alerts_webhook
FEISHU_SECRET_ALERTS=your_feishu_alerts_secret

# A-share report distribution
A_SHARE_REPORT_DELIVERY=auto
MARKET_INTEL_CLIENT_CHAT_ID=your_client_chat_id
MARKET_INTEL_INTERNAL_CHAT_ID=your_internal_chat_id
MARKET_INTEL_PUBLIC_CHAT_ID=your_public_chat_id
MARKET_INTEL_DISABLED_CHAT_ID=legacy_target_to_filter
MORNING_ENABLE_AI_NEWS=0

# External data and owner artifact roots are deployment-provided; no home-directory default exists.
# DATA_PLATFORM_ROOT=/path/to/local/data
# A_SHARE_DAILY_CLEAN_DIR=$DATA_PLATFORM_ROOT/assets/tushare/a_share/daily/a_share_all_daily_clean_latest/data
# WATCHLIST20_OUTPUT_ROOT=$DATA_PLATFORM_ROOT/strategy_outputs/watchlist20
# WATCHLIST20_NEWS_HEAT_ROOT=$DATA_PLATFORM_ROOT/strategy_inputs/watchlist20/news_heat
# WATCHLIST20_MINUTE_SH_ROOT=$DATA_PLATFORM_ROOT/assets/tushare/a_share/minute_1m_watchlist_sh
# WATCHLIST20_MINUTE_SZ_ROOT=$DATA_PLATFORM_ROOT/assets/tushare/a_share/minute_1m_watchlist_sz
# WATCHLIST20_MINUTE_QUOTA_CONSUMER=daily_watch20
# Shared TuShare minute quota ledger; start with observe, then promote to enforce.
# MDP_TUSHARE_MINUTE_QUOTA_MODE=observe
# MDP_TUSHARE_MINUTE_QUOTA_DB=$DATA_PLATFORM_ROOT/metadata/tushare/minute_quota/minute_quota.sqlite3
# MDP_TUSHARE_MINUTE_QUOTA_LIMIT_ROWS=80000000
# MDP_TUSHARE_MINUTE_QUOTA_SAFETY_ROWS=10000000
# A_SHARE_MINUTE_FACTOR_QUOTA_CONSUMER=top200_factor_observation
# A_SHARE_MINUTE_FACTOR_SDK_RETRY_COUNT=1
# WATCHLIST20_HISTORY_CALENDAR_DAYS=1100
# WATCHLIST20_TRAIN_WINDOW_DATES=504
# WATCHLIST20_DECAY_HALFLIFE_DATES=126
# WATCHLIST20_ABLATION_DATES=63
# WATCHLIST20_ABLATION_ROLLING_FOLDS=3
# WATCHLIST20_ABLATION_PORTFOLIO_SIZE=20
# WATCHLIST20_ABLATION_SINGLE_SIDE_COST_BPS=10
# WATCHLIST20_MEMORY_LIMIT=12GB
# WATCHLIST20_THREADS=3

# Optional overrides. OANDA_TOKEN wins over OANDA_API_TOKEN and api_keys.json.oanda;
# FRED_API_KEY wins over api_keys.json.fred. FRED public CSV remains keyless fallback.
OANDA_TOKEN=your_oanda_practice_token
# FRED_API_KEY=your_fred_api_key

# Whether to allow Yahoo Finance as a last-resort fallback (0 = disabled, 1 = enabled)
# yfinance is default to no as the network environment complexity
YFINANCE_FALLBACK=0

# API keys defined below are for the fallback purpose, the project prefers to use the ones in the api_keys.json file

FINANCIAL_MODELING_PREP=your_fallback_financial_modeling_prep_api_key
TWELVE_DATA=your_fallback_twelve_data_api_key
FINNHUB=your_fallback_finnhub_api_key
TRADING_ECONOMICS_USER=your_fallback_trading_economics_user_api_key
TRADING_ECONOMICS_PASSWORD=your_fallback_trading_economics_password_api_key
ALPHA_VANTAGE=your_fallback_alpha_vantage_api_key
ALPACA_KEY_ID=your_fallback_alpaca_key_id
ALPACA_SECRET=your_fallback_alpaca_secret_api_key
